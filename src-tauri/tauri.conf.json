{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Desktop",
  "version": "0.1.15",
  "identifier": "com.tiktokdesk.client",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        "shell-only",
        "settings-only",
        "tray-only"
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/app.ico"
    ],
    "publisher": "TikTok Desktop (unofficial)",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/app.ico",
        "uninstallerIcon": "icons/app.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCRjVCRTgzQjk4Qjg3NjAKUldSZ2g0dTVnNzcxeTdnM3AwaHByM1h6a3NVT21wUzM2UVNpaDZTeEJmRFRuSnBzRVdvV0tDQUgK",
      "endpoints": [
        "https://github.com/JNathan34/tiktok-desktop-windows/releases/latest/download/latest.json"
      ]
    }
  }
}
