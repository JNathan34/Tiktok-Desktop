{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Desktop",
  "version": "0.1.0",
  "identifier": "com.tiktokdesk.client",
  "build": {"beforeBuildCommand":"npm run build","beforeDevCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["shell-only"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/app.ico"],
    "publisher": "TikTok Desktop (unofficial)",
    "windows": {"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"installerIcon":"icons/app.ico","installMode":"currentUser"}}
  }
}
